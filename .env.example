# Copy to .env and fill in. Never commit .env.
# Generate a key:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me

# verified = Grounding DINO + ByteTrack + SmolVLM2 (default) | vlm = legacy Qwen + OWLv2 | mock = placeholder
PIPELINE=verified
MOCK_MODE=violation
MOCK_DELAY_SEC=3
MAX_UPLOAD_MB=300

# Cloudflare named tunnel token (Zero Trust -> Networks -> Tunnels -> your tunnel -> token)
TUNNEL_TOKEN=

# ---- verified engine (configs/verified.yaml holds every other parameter) ----
DINO_PATH=C:\opt\forte\models\grounding-dino-tiny
SMOLVLM_PATH=C:\models\smolvlm2-2.2b-instruct
# VERIFIED_THRESHOLDS=configs\thresholds_verified.json   (written by: python scripts/run_vlm.py calibrate)

# ---- legacy engine models (PIPELINE=vlm only) ----
VLM_PATH=C:\models\qwen2.5-vl-7b
OWL_PATH=C:\models\owlv2-base
# keep these as they are: the thresholds were calibrated with them
VLM_MAX_PIXELS=921600
FACT_FPS=1
DETS=owl

# ---- speed / behaviour ----
# SAHI tiles for small objects every N sampled frames (raise to 3-4 if a long video gets close to 5 minutes)
TILE_EVERY=2
# condition chains in the service: auto = only if calibration switched at least one on | on | off
CHAINS=auto
# one generated sentence per event (Qwen)
STATE_DESCRIBE=1
PYTHONIOENCODING=utf-8
